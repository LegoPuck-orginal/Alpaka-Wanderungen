{
  "name": "alpaka-wanderungen",
  "version": "1.0.0",
  "description": "Premium Alpaka-Wanderungen Website mit Admin-Panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss css/main.css -o dist/css/main.min.css --env production",
    "build:js": "webpack --mode production",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:js\"",
    "watch:css": "postcss css/main.css -o dist/css/main.min.css --watch",
    "watch:js": "webpack --mode development --watch",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "test": "jest",
    "serve": "live-server --port=3000 --host=0.0.0.0",
    "deploy": "npm run build && npm run optimize",
    "optimize": "npm run optimize:images && npm run optimize:html",
    "optimize:images": "imagemin images/**/*.{jpg,png,gif,svg} --out-dir=dist/images",
    "optimize:html": "html-minifier --input-dir=. --output-dir=dist --file-ext=html --remove-comments --minify-css --minify-js"
  },
  "keywords": [
    "alpaka",
    "wanderungen",
    "tourismus",
    "natur",
    "website",
    "booking-system"
  ],
  "author": "Alpaka-Wanderungen Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "body-parser": "^1.20.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "validator": "^13.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "imagemin": "^8.0.1",
    "imagemin-cli": "^7.0.0",
    "html-minifier": "^4.0.0",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LegoPuck-orginal/Alpaka-Wanderungen.git"
  },
  "bugs": {
    "url": "https://github.com/LegoPuck-orginal/Alpaka-Wanderungen/issues"
  },
  "homepage": "https://github.com/LegoPuck-orginal/Alpaka-Wanderungen#readme"
}
