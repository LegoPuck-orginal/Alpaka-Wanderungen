# Environment Configuration
NODE_ENV=development
PORT=3000

# JWT Secret (Ändere das für Production!)
JWT_SECRET=alpaka-wanderungen-super-secret-key-2025

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact Email
CONTACT_EMAIL=info@alpaka-wanderungen.de

# Database (falls später SQLite/MySQL verwendet wird)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alpaka_wanderungen
DB_USER=alpaka_user
DB_PASS=secure_password

# Upload Limits
MAX_FILE_SIZE=10mb
UPLOAD_DIR=uploads/

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Development
DEBUG=true
LOG_LEVEL=info
